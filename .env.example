# YouTube Data API v3 key — create one at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3". Never hardcode this in source files.
VITE_YOUTUBE_API_KEY=your_key_here

# Optional second YouTube API key — used automatically when the primary key
# is exhausted (quota exceeded) so playback keeps working.
VITE_YOUTUBE_API_KEY_2=

# Curated playlist IDs per device/artist (optional). Paste either a raw
# playlist ID (PLabcdef...) or a full playlist URL — the app extracts the ID.
# Leave empty to fall back to `{artist} official audio` search.
VITE_PLAYLIST_SYNTHWAVE_PRO=
VITE_PLAYLIST_NEON_DREAMERS=
VITE_PLAYLIST_HOME_STEREO_BT=

# Radio live stream (optional): raw video ID, /live/ or watch URL. Leave
# empty to show "STATION OFFLINE" in Radio.
VITE_LIVE_STREAM_ID=

# Admin console (optional, server-side — set on the Vercel project dashboard
# or in your local shell). Enables POST /api/admin/config: update the
# built-in playlists, live stream and YouTube API key at runtime from the
# /#admin page. Writes require the matching x-admin-token header. Needs
# Upstash Redis too.
#   ADMIN_TOKEN
# Without ADMIN_TOKEN the admin page can read but never save.
# The admin-set API key is write-only (never returned by any endpoint); when
# active, YouTube calls go through the /api/yt proxy, which injects it
# server-side. Without an override the app uses VITE_YOUTUBE_API_KEY directly.
ADMIN_TOKEN=

# Realtime listener counter (optional). Leave empty to use the built-in
# /api/presence serverless function on Vercel (or the local server.js backend
# in dev). To share presence across every instance — the 1000-listener setup —
# set Upstash Redis credentials in the Vercel project dashboard (and in your
# local shell for the dev backend):
#   UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
# Without them, Vercel hides the counter and the local backend counts
# in-memory per instance.
VITE_PRESENCE_URL=